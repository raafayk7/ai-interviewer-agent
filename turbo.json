{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "PORT",
    "HOST",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "GEMINI_MODEL",
    "DEEPGRAM_API_KEY",
    "DEEPGRAM_MODEL",
    "DEEPGRAM_LANGUAGE",
    "DEEPGRAM_SAMPLE_RATE",
    "DEEPGRAM_ENCODING",
    "ELEVENLABS_API_KEY",
    "ELEVENLABS_VOICE_ID",
    "ELEVENLABS_MODEL_ID",
    "ELEVENLABS_OUTPUT_FORMAT",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LANGFUSE_BASE_URL",
    "FILE_STORAGE_DRIVER",
    "FILE_STORAGE_ROOT",
    "FILE_STORAGE_SIGNING_SECRET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "S3_TEST_ENDPOINT",
    "S3_TEST_REGION",
    "S3_TEST_BUCKET",
    "S3_TEST_ACCESS_KEY_ID",
    "S3_TEST_SECRET_ACCESS_KEY",
    "S3_TEST_FORCE_PATH_STYLE",
    "TRUST_PROXY",
    "RATE_LIMIT_AUTH_PER_MIN",
    "RATE_LIMIT_CANDIDATE_SESSION_PER_MIN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "CORS_ALLOWED_ORIGINS",
    "CANDIDATE_LINK_SECRET",
    "CANDIDATE_LINK_TTL_SECONDS",
    "CANDIDATE_PUBLIC_BASE_URL",
    "ELEVENLABS_AGENT_ID",
    "ELEVENLABS_WEBHOOK_SECRET",
    "ELEVENLABS_TOOL_WEBHOOK_SECRET",
    "GEMINI_AGENT_MODEL",
    "RECONCILE_THRESHOLD_MINUTES",
    "INTERVIEW_TIME_REMAINING_INTERVAL_TURNS",
    "INTERVIEW_HARD_CEILING_GRACE_SECONDS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
