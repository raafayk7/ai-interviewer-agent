# ──────────────────────────────────────────────────────────────
# Web (Next.js) environment — copy to .env.local and fill in.
# Only NEXT_PUBLIC_* vars are read by the app (validated in src/lib/env.ts).
# ──────────────────────────────────────────────────────────────

# Base URL of the backend API (REST + better-auth mount + webhooks live here).
# Used by services, the auth client, and candidate-link fetches.
#   Local dev:  http://localhost:3002
#   Staging:    https://<your-backend>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3002
