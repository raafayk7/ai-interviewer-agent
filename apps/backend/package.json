{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "voice:latency": "tsx src/scripts/measure-voice-latency.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.61",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@carbonteq/fp": "^0.9.1",
    "@deepgram/sdk": "^5.0.0",
    "@elevenlabs/elevenlabs-js": "^2.49.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@langfuse/client": "^5.3.0",
    "@langfuse/otel": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@repo/application": "workspace:*",
    "@repo/domain": "workspace:*",
    "ai": "^6.0.158",
    "better-auth": "^1.6.10",
    "drizzle-orm": "^0.45.2",
    "elevenlabs": "^1.59.0",
    "fastify": "^5.3.3",
    "langfuse": "^3.38.20",
    "postgres": "^3.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.39.1",
    "tsx": "^4.19.4",
    "typescript": "5.9.2",
    "vitest": "^3.2.1"
  }
}
