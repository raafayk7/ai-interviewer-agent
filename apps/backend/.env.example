# ──────────────────────────────────────────────────────────────
# Backend (Fastify) environment — copy to .env and fill in.
# Generate secrets with:  openssl rand -base64 32
# ──────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# Postgres connection.
#   Local dev: a plain Postgres URL.
#   Staging (Supabase): use the DIRECT connection (:5432) for migrations.
#   The pooled transaction-mode URL (:6543) requires prepare=false in the
#   postgres.js driver — keep migrations on the direct URL.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer

# ── Auth: better-auth (recruiter) — ADR-016 ──
# 32+ random bytes.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# The backend's own public origin (where better-auth is mounted).
#   Local dev: http://localhost:3002   Staging: https://<your-backend>.onrender.com
BETTER_AUTH_URL=http://localhost:3002
# Required in production. Comma-separated origins allowed to call /api/auth/*
# (better-auth CSRF guard). Staging: add the Vercel frontend origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Required in production. Comma-separated origins allowed for non-auth
# cross-origin browser requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auth: candidate HMAC signed link — ADR-017 ──
# 32+ random bytes, distinct from BETTER_AUTH_SECRET.
CANDIDATE_LINK_SECRET=replace-with-openssl-rand-base64-32
# Link TTL in seconds. Optional — defaults to 7 days (604800).
CANDIDATE_LINK_TTL_SECONDS=604800
# Public base URL the candidate link points at (the FRONTEND origin).
# Optional — falls back to BETTER_AUTH_URL, then http://localhost:3000.
CANDIDATE_PUBLIC_BASE_URL=http://localhost:3000

# ── File storage ──
# Driver selection (read by the composition root once the S3 adapter lands).
#   "local" = disk (dev fallback only — NOT usable on Render free, no disk).
#   "s3"    = S3-compatible object storage: MinIO locally, Supabase Storage in
#             staging. One adapter, one code path. Defaults to "local" if unset.
FILE_STORAGE_DRIVER=local

# -- local driver (FILE_STORAGE_DRIVER=local) --
FILE_STORAGE_ROOT=./.storage
# Signs local file URLs. 32+ random bytes.
FILE_STORAGE_SIGNING_SECRET=replace-with-openssl-rand-base64-32

# -- s3 driver (FILE_STORAGE_DRIVER=s3) --
# Generic S3 API — same vars target MinIO (local), Supabase Storage (staging),
# AWS S3, or R2. Path-style addressing is REQUIRED for MinIO and Supabase.
#   Local dev (MinIO — root docker-compose.yml, profile dev):
#     S3_ENDPOINT=http://localhost:9000  · key/secret = minioadmin / minioadmin
#   Staging (Supabase Storage):
#     S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#     credentials from Supabase dashboard → Storage → S3 Access Keys
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=interview-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── AI: Gemini (interview agent, evaluation, document extraction) — ADR-003 ──
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key-here
# Optional overrides — both default to gemini-2.5-pro if unset.
GEMINI_MODEL=gemini-2.5-pro
GEMINI_AGENT_MODEL=gemini-2.5-pro

# ── Voice: ElevenLabs Conversational AI — ADR-029 / 033 / 034 ──
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# The static agent id. Must carry the override allow-list flags
# (agent.prompt.prompt + agent.first_message) or the backend fails fast at boot.
ELEVENLABS_AGENT_ID=your-static-agent-id-here
# Post-call webhook HMAC (workspace secret).
ELEVENLABS_WEBHOOK_SECRET=your-workspace-webhook-hmac-secret-here
# Per-tool webhook HMAC. 32+ random bytes.
ELEVENLABS_TOOL_WEBHOOK_SECRET=at-least-32-chars-random-bytes-base64

# ── Interview pacing — ADR-006 / 035 ──
INTERVIEW_TIME_REMAINING_INTERVAL_TURNS=3
INTERVIEW_HARD_CEILING_GRACE_SECONDS=30
# Post-call transcript reconciliation window (minutes). Optional — defaults to 90.
RECONCILE_THRESHOLD_MINUTES=90

# ── Observability: Langfuse — ADR-004 ──
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ──────────────────────────────────────────────────────────────
# LEGACY — Deepgram "sandwich" voice path (pre-ADR-029).
# Still REQUIRED at boot: buildInterviewSessionDeps() constructs the Deepgram +
# ElevenLabs-TTS clients unconditionally, even though no client connects to the
# /interviews/:id/session WebSocket route anymore (live voice is browser↔
# ElevenLabs Conversational AI). Keep these set until the sandwich is removed.
# ──────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-key-here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_ENCODING=linear16
# ElevenLabs custom-TTS params — read only by the legacy sandwich provider.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ──────────────────────────────────────────────────────────────
# Tests (optional) — Drizzle integration tests need the test-postgres
# container (compose.test.yml, :54329). Not required to run the app.
# ──────────────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/ai_interviewer_test
